<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/mizan_widget_background"
  android:gravity="end"
  android:orientation="vertical"
  android:padding="14dp">
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:text="جلسات ومواعيد اليوم"
    android:textColor="#142B45"
    android:textSize="15sp"
    android:textStyle="bold" />
  <TextView
    android:id="@+id/mizan_widget_items"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:ellipsize="end"
    android:gravity="end|center_vertical"
    android:maxLines="4"
    android:paddingTop="5dp"
    android:text="لا توجد جلسات اليوم، يومك سعيد سيادة المستشار"
    android:textColor="#394B5E"
    android:textSize="12sp" />
  <TextView
    android:id="@+id/mizan_widget_add_case"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:background="#142B45"
    android:gravity="center"
    android:minWidth="112dp"
    android:paddingHorizontal="12dp"
    android:text="＋ إضافة قضية"
    android:textColor="#FFFFFF"
    android:textSize="12sp"
    android:textStyle="bold" />
</LinearLayout>
